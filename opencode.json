{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@latest"],
      "enabled": true
    }
  },
  "agent": {
    "plan": { "mode": "primary", "tools": { "write": false, "edit": false, "bash": false } },
    "build": { "mode": "primary", "tools": { "write": true, "edit": true, "bash": true } }
  }
}